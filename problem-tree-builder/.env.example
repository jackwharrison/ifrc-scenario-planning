# Copy to .env for local use, or set these as Application settings in Azure App Service.
SECRET_KEY=change-me-to-a-long-random-string
# Azure: keep the database under /home, which survives restarts and deployments.
DATABASE_PATH=/home/data/app.db
# Label printed at the bottom of the Word document.
CLASSIFICATION=Internal
# Set to false only when running locally over plain http.
SESSION_COOKIE_SECURE=true
